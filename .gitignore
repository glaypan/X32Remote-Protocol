# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 构建产物 ----
build/
dist/
*.class

# ---- 本机/运行时状态 ----
# 模拟器运行时配置（含用户自定义快捷键与卡片，属本机状态，不入库）
X32Simulator/user_config.json
X32Simulator/*.log
X32Simulator/_port_test.log

# ---- Swift / 本地校验工作区 ----
X32Remote-ios/.localverify/
X32Remote-ios/.build/
.localverify/

# ---- 编辑器 / 系统 ----
.DS_Store
._*
.vscode/
.idea/
*.swp

# ---- 发布产物（由 tools/make_release.py 生成，可随时重建）----
outputs/*.zip
# 二进制产物走 GitHub Release 附件，不入库（避免仓库体积膨胀）
outputs/*.apk
outputs/*.ipa
# 旧版桌面版包归档（已被新版 Release 附件取代，仅本地留存）
outputs/archive/

# ---- 目视验证截图（本地截图存档，非交付物）----
outputs/verify/
outputs/*页-*.png

# ---- 本地 Swift 工具链安装目录（体积大，且可通过 tools/local_verify.sh 重建）----
.swift-setup/

# ---- iOS 工程是独立 git 仓库（github.com/glaypan/X32Remote），此处不重复纳入 ----
/X32Remote-ios/

# ---- Android 工程是独立 git 仓库（ASCII 路径，在工作区之外），此处不重复纳入 ----
# （tools/export_fx_calibration.py 早年把 Android assets 误写到工作区内，
#  误建过只有 assets 的幽灵目录；工具已修，这里再兜一层）
/X32RemoteAndroid/

# ---- 会话/工具状态 ----
.workbuddy/
*.genie

# ---- 回归测试临时文件 / 浏览器会话 ----
X32Simulator/_regr_*.json
X32Simulator/.playwright-cli/
